# ================= Choose ONE model provider =================
# FREE, local, private (default):  ollama   -> run: docker compose --profile free up --build
# FREE, no LLM at all:             mock     -> run: docker compose up --build
# FREE tier of a hosted API:       openai_compat (see below)
# Paid:                            anthropic
LLM_PROVIDER=ollama

# --- ollama (free, runs in Docker, needs ~4 GB RAM and ~2 GB disk for the default model) ---
OLLAMA_MODEL=llama3.2:3b

# --- openai_compat (free tiers; check each provider's current limits and data-use terms) ---
# Groq:   OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- anthropic (paid, optional) ---
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# ================= Database (docker compose) =================
MYSQL_PASSWORD=rakshak
MYSQL_ROOT_PASSWORD=root

# ================= Only when running WITHOUT docker =================
# DATABASE_URL=sqlite:///./rakshak.db
# STIX_PATH=data/enterprise-attack.json
